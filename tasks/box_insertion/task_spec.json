    "stage": "robot_v1",
    "physics": "passive_free_body_contact_only",
    "score_max": 100.0,
    "notes": "The block width is sampled uniformly from 0.60 to 1.00 m. For every scenario the slot opening is derived as block width + at least 0.05 m total nominal clearance (2.5 cm per side at the minimum). The gravity-loaded free rigid body has two independently sampled bottom contact regions separated at 20-80% of its width. It must be pushed to within 0.005 m of the deep slot back wall and settle before success. Task step never writes its qpos/qvel; off-center pushes can translate, rotate or tip it. The baseline may fail. Default construction samples the Profile using seed (0 if omitted); reset reuses that Task Instance. The two regions also have unequal sampled densities: light 350-550 and heavy 850-1150 kg/m3, with a random heavy side. Mass, COM and inertia follow the solid volumes. Left/right wall sliding friction is independently uniform 3.5-5.0; back wall 1.0-2.0. slot_wall_friction order is left, right, back; density order is left, right.",
    "episode_randomization": {
      "version": 1,
      "domains": {
        "friction_multiplier": [
          0.6,
          1.4
        ],
        "friction_limits": [
          0.01,
          0.6
        ],
        "mass_scale": [
          0.7,
          1.3
        ]
      },
      "sampler": "react_manip.instances.variation.sample_variation",
      "storage": "Episode variation + runtime + initial_state; Task scenario is the baseline",
      "schedule": "independently shuffled five-stratum batches; two practice batches and one exam batch use the same domain; phone small count alternates 2/3",
      "replay": "rebuild resolved Episode model; verify full runtime identity; restore exact initial state; no resampling during reset/step",
      "policy_visibility": "qualitative runtime English instructions only; sampled values, solution axes, small-support names and files remain private"
    }
  },
