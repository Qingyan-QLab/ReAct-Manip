<?xml version="1.0" encoding="utf-8"?>
<mujoco model="leveling_board1">
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast" iterations="100"/>
  <worldbody>
    <!-- A 20 ms contact response avoids chatter at the 2 ms physics step.
         The 0.5 mm impedance width limits compression in loaded shim stacks. -->
    <geom name="table" type="box" pos="0 0 0.655" size="0.7 0.5 0.025"
          friction="0.78 0.42 0.05" condim="3" solref="0.02 1" solimp="0.90 0.96 0.0005"/>
    <geom name="support_block" type="box" pos="-0.325 0 0.74" size="0.025 0.09 0.06"
          friction="0.90 0.55 0.08" condim="3" solref="0.02 1" solimp="0.90 0.96 0.0005"/>
    <!-- Pivot at the top of the fixed left support. At +8 degrees the free
         right end begins near the tabletop and can be raised by stacked shims. -->
    <body name="board" pos="-0.30 0 0.81">
      <joint name="board_hinge" type="hinge" axis="0 1 0" limited="true"
             range="-0.10 0.22" damping="0.25" frictionloss="0.005"/>
      <geom name="long_board_collision" type="box" pos="0.45 0 0"
            size="0.45 0.06 0.01" mass="0.08" friction="0.72 0.38 0.04"
            condim="3" solref="0.02 1" solimp="0.90 0.96 0.0005"/>
    </body>
    <!-- Free objects have no joint drag, dry friction or artificial inertia.
         Dissipation comes from surface contact, so an edge-balanced block can tip. -->
    <body name="shim_01" pos="0.32 -0.30 0.695"><freejoint name="shim_01_free"/><geom name="shim_01_collision" type="box" size="0.05 0.05 0.015" mass="0.09" friction="0.72 0.38 0.04" condim="3" solref="0.02 1" solimp="0.90 0.96 0.0005"/></body>
    <body name="shim_02" pos="0.44 -0.30 0.700"><freejoint name="shim_02_free"/><geom name="shim_02_collision" type="box" size="0.05 0.05 0.020" mass="0.12" friction="0.72 0.38 0.04" condim="3" solref="0.02 1" solimp="0.90 0.96 0.0005"/></body>
    <body name="shim_03" pos="0.56 -0.30 0.705"><freejoint name="shim_03_free"/><geom name="shim_03_collision" type="box" size="0.05 0.05 0.025" mass="0.15" friction="0.72 0.38 0.04" condim="3" solref="0.02 1" solimp="0.90 0.96 0.0005"/></body>
    <body name="shim_04" pos="0.38 -0.18 0.715"><freejoint name="shim_04_free"/><geom name="shim_04_collision" type="box" size="0.05 0.05 0.035" mass="0.21" friction="0.72 0.38 0.04" condim="3" solref="0.02 1" solimp="0.90 0.96 0.0005"/></body>
    <body name="shim_05" pos="0.52 -0.18 0.725"><freejoint name="shim_05_free"/><geom name="shim_05_collision" type="box" size="0.05 0.05 0.045" mass="0.27" friction="0.72 0.38 0.04" condim="3" solref="0.02 1" solimp="0.90 0.96 0.0005"/></body>
    <body name="shim_06" pos="0.62 -0.18 0.70"><freejoint name="shim_06_free"/><geom name="shim_06_collision" type="box" size="0.05 0.05 0.03" mass="0.18" friction="0.72 0.38 0.04" condim="3" solref="0.02 1" solimp="0.90 0.96 0.0005"/></body>
    <body name="shim_07" pos="0.36 0.30 0.70"><freejoint name="shim_07_free"/><geom name="shim_07_collision" type="box" size="0.05 0.05 0.025" mass="0.15" friction="0.72 0.38 0.04" condim="3" solref="0.02 1" solimp="0.90 0.96 0.0005"/></body>
    <body name="shim_08" pos="0.54 0.30 0.70"><freejoint name="shim_08_free"/><geom name="shim_08_collision" type="box" size="0.05 0.05 0.04" mass="0.24" friction="0.72 0.38 0.04" condim="3" solref="0.02 1" solimp="0.90 0.96 0.0005"/></body>
  </worldbody>
</mujoco>
