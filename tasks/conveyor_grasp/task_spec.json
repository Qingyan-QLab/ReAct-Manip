{
  "api_version": "2.0",
  "task_id": "conveyor_grasp",
  "task_version": "3.0",
  "task_type": "one_shot",
  "required_arms": 1,
  "required_gripper": "parallel",
  "supported_robots": [
    "dual_piperx"
  ],
  "horizon_sec": 300,
  "control_hz": 20,
  "done_behavior": "stop",
  "success": {
    "min_occupancy": 0,
    "min_events": 1,
    "max_failures": null,
    "require_terminal_success": true
  },
  "observation": {
    "modalities": [
      "proprio",
      "visual",
      "feedback",
      "geometry"
    ],
    "default_policy_view": [
      "proprio",
      "visual",
      "feedback"
    ],
    "geometry_view": "internal",
    "fields": {
      "visual": [
        "robot0_head_camera",
        "robot0_wrist_right",
        "robot0_wrist_left"
      ],
      "feedback": [
        "score",
        "remaining_count",
        "target_count"
      ],
      "geometry": [
        "objects.pose",
        "objects.category_id",
        "objects.phase",
        "baskets.bounds",
        "baskets.category_id",
        "object_basket",
        "correct_mask",
        "mixed_baskets"
      ]
    },
    "visibility": {
      "policy": "proprio+visual+feedback",
      "oracle": "all",
      "benchmark_log": "all"
    }
  },
  "action": {
    "type": "eef_delta",
    "shape": [
      7
    ],
    "bounds": [
      -1,
      1
    ],
    "frame": "world"
  },
  "feedback": {
    "events": [
      "object_recycled",
      "correct_placement",
      "correct_placement_removed",
      "all_objects_sorted"
    ],
    "fields": [
      "total_score",
      "score_delta",
      "completion_fraction",
      "remaining_count",
      "mixed_basket_count",
      "examples_retained",
      "recycle_count"
    ],
    "success_signals": [
      "success_state",
      "terminal_success"
    ]
  },
  "metadata": {
    "camera_contract": {
      "version": "3.0",
      "fixed": [
        "workspace_oblique",
        "workspace_top",
        "room_overview"
      ],
      "mounted": "query get_camera_specs(); only physical embodiment sensors",
      "observation_key": "images",
      "default_resolution": [
        640,
        480
      ],
      "room_and_debug_opt_in": true,
      "policy_cameras": [
        "robot0_head_camera",
        "robot0_wrist_right",
        "robot0_wrist_left"
      ],
      "policy_mounting": "robot_main_and_wrists"
    },
    "score_max": 100.0,
    "instance_contract": "tasks/conveyor_grasp/instance_contract.json",
    "evaluation": {
      "practice_episodes": 10,
      "exam_episodes": 5,
      "exam_adaptation": "online",
      "score_key": "total_score",
      "aggregate": "mean_exam_task_score",
      "instance_robot": "dual_piperx"
    },
    "episode_randomization": {
      "version": 1,
      "domains": {
        "belt_speed_m_s": [
          0.08,
          0.2
        ],
        "target_size_scale": [
          0.8,
          1.15
        ]
      },
      "sampler": "react_manip.instances.variation.sample_variation",
      "storage": "Episode variation + runtime + initial_state; Task scenario is the baseline",
      "schedule": "independently shuffled five-stratum batches; two practice batches and one exam batch use the same domain; phone small count alternates 2/3",
      "replay": "rebuild resolved Episode model; verify full runtime identity; restore exact initial state; no resampling during reset/step",
      "policy_visibility": "qualitative runtime English instructions only; sampled values, solution axes, small-support names and files remain private"
    }
  },
  "evaluation": {
    "protocol": "practice_exam",
    "practice_episodes": 10,
    "exam_episodes": 5,
    "exam_adaptation": "online",
    "scoring": {
      "primary": "mean_exam_task_score",
      "score_key": "total_score"
    }
  }
}
